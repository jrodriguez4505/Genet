{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taskorg://schemas/run_state",
  "title": "Run state: roster, goal, schedule, context, purpose and method",
  "type": "object",
  "required": ["roster", "goal", "schedule", "context", "purpose", "method"],
  "additionalProperties": false,
  "properties": {
    "roster": {
      "type": "object",
      "required": ["lead_id", "slots", "primary"],
      "properties": {
        "lead_id": { "type": "string" },
        "slots": { "type": "array", "items": { "$ref": "#/$defs/slot" } },
        "primary": { "type": "string" }
      }
    },
    "goal": {
      "type": "object",
      "required": ["goal", "success_criteria"],
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "success_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "schedule": {
      "type": "object",
      "required": ["cadence", "checkpoints"],
      "properties": {
        "cadence": { "type": "string" },
        "checkpoints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "context": {
      "type": "object",
      "required": ["context", "done_when"],
      "properties": {
        "context": { "type": "string" },
        "done_when": { "type": "string" },
        "projections": { "type": "array", "items": { "type": "string" } },
        "context_sufficient": { "type": "boolean" }
      }
    },
    "purpose": {
      "type": "object",
      "required": ["purpose"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "open_review_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "method": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": { "type": "string" },
        "axes": {
          "type": "array",
          "items": { "enum": ["parallel", "fallback", "reroute", "sequential", "reverse", "fan_in"] }
        },
        "abort_criteria": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "slot": {
      "type": "object",
      "required": ["id", "function"],
      "properties": {
        "id": { "type": "string" },
        "function": { "enum": ["lead", "worker", "verifier", "memory", "reviewer"] },
        "skill": { "enum": ["execute", "retrieve", "reason", "draft", "simulate", "observe", "verify"] },
        "channel_id": { "type": ["string", "null"] }
      }
    }
  }
}
